# アプリケーション名
PROJECT_NAME=savorit

# API のバージョン付きプレフィックス
API_V1_STR=/api/v1

# 実行環境: local, staging, production
ENVIRONMENT=local

# 標準のフロントエンドURL
FRONTEND_HOST=http://localhost:5173

# 追加で許可するCORSオリジン。複数指定する場合はカンマ区切り。
# 例: BACKEND_CORS_ORIGINS=http://localhost:3000,https://example.com
BACKEND_CORS_ORIGINS=
